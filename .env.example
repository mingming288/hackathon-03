# 前端环境变量(可选)
# 开发时 vite 代理已把 /api 转发到本地后端;生产 Vercel 同源部署。
# 仅当前后端分开部署、需指向独立后端域名时才填写下面这项。
# VITE_API_BASE=https://your-backend.example.com

# ── 后端密钥不在这里 ──
# 后端 (DeepSeek / gpt-image-2 / Supabase) 的 key 配置在 server/.env
# 部署到 Vercel 时,把 server/.env 里的 KEY 配到 Vercel 项目环境变量:
#   DEEPSEEK_API_KEY, IMAGE_API_KEY, IMAGE_BASE_URL, IMAGE_MODEL, IMAGE_PATH
#   SUPABASE_URL, SUPABASE_SERVICE_KEY, SUPABASE_ANON_KEY
#   CORS_ORIGINS(填前端线上域名)
