# 前端环境变量(可选)
# 开发时 vite 代理已把 /api 转发到本地后端;生产 Vercel 同源部署。
# 仅当前后端分开部署、需指向独立后端域名时才填写下面这项。
# VITE_API_BASE=https://your-backend.example.com

# ── 后端环境变量 (配置在 server/.env) ──

# DeepSeek API (文本生成)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60.0
DEEPSEEK_MAX_RETRIES=2

# 图像生成 API (gpt-image-2 via llmgateway)
IMAGE_API_KEY=your_image_api_key
IMAGE_BASE_URL=https://www.llmgateway.cn
IMAGE_MODEL=gpt-image-2
IMAGE_PATH=/v1/images/generations
IMAGE_TIMEOUT=180.0
IMAGE_MAX_RETRIES=2

# Supabase (主数据库 + 存储)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_BUCKET=posters

# 限流配置
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# 文件清理配置
CLEANUP_MAX_AGE_DAYS=7

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 服务配置
PORT=8766
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENV=local
