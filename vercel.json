{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "server/api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "server/**",
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/api/index.py" }
  ],
  "functions": {
    "server/api/index.py": {
      "maxDuration": 60
    }
  }
}
